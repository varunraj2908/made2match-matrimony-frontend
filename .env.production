# PRODUCTION environment variables.
# Read automatically by `next build` / `next start` when NODE_ENV=production.
# On Vercel/Netlify, set these in the host dashboard instead (dashboard wins).
#
# ⚠️ REPLACE the placeholders below with your real production values before deploying.
# All NEXT_PUBLIC_* values are exposed to the browser — never put secrets here.

# Backend API base URL — MUST point to your live API (not localhost).
# NEXT_PUBLIC_API_BASE_URL=http://16.192.94.191:8080/api/v1
NEXT_PUBLIC_API_BASE_URL=https://made2match.in/api/v1
# NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1

# Public site origin (no trailing slash) — canonical/OG URLs, sitemap & robots.
# NEXT_PUBLIC_SITE_URL=http://16.192.94.191:3000
NEXT_PUBLIC_SITE_URL=https://made2match.in

# Google Analytics 4 Measurement ID (G-XXXXXXXXXX). Leave empty to disable.
NEXT_PUBLIC_GA_ID=

# Google Search Console verification token (HTML-tag method). Leave empty if using DNS.
NEXT_PUBLIC_GSC_VERIFICATION=

# Optional: Google Maps Embed API key for the LocationMap section.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
