NEXT_PUBLIC_API_BASE_URL=https://made2match.in/api/v1
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# --- SEO ---
# Production origin (no trailing slash). Used for canonical/OG URLs, sitemap & robots.
# Set this in your hosting env (e.g. Vercel) to the real domain once decided.
# NEXT_PUBLIC_SITE_URL=http://16.192.94.191:3000
NEXT_PUBLIC_SITE_URL=https://made2match.in

# Google Analytics 4 Measurement ID (G-XXXXXXXXXX). Leave empty to disable.
NEXT_PUBLIC_GA_ID=

# Google Search Console verification token (the content="..." value from the
# "HTML tag" verification method). Leave empty if verifying via DNS instead.
NEXT_PUBLIC_GSC_VERIFICATION=
